#!/usr/bin/env python3

import argparse
import hashlib
import ipaddress
import json
import os
import signal
import subprocess
import sys
from configparser import ConfigParser, UNNAMED_SECTION
from pathlib import Path, PosixPath, PurePosixPath
from string import Formatter
from subprocess import DEVNULL
from typing import List, Optional

CONF_DIR = Path.home() / ".config/larcik"
CONF_FILE = CONF_DIR / "larcik.cfg"
XDG_RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getegid()}")
HOOKS_DIR = PosixPath(XDG_RUNTIME_DIR) / "larcik/hooks.d"

PODMAN_GLOBAL_ARGS = [
    "--log-level", "error"
]


class Config:
    def __init__(
        self,
        wd: Path = Path.cwd(),
        image: str = "ubuntu:latest",
        net: str = "none",
    ):
        self.wd = wd
        self.image = image
        self.net = net
        self.mount_rw: List[Path] = []
        self.mount_ro: List[Path] = []

    @staticmethod
    def load() -> "Config":
        cfg = Config()
        cfg.update_from_path(CONF_FILE)
        return cfg

    def update_from_path(self, path: Path) -> None:
        parser = ConfigParser(
            allow_unnamed_section=True,
            allow_no_value=True,
            delimiters=("=",),
            comment_prefixes=("#",),
            interpolation=None,
            converters={
                # Strip double quotes around the strings
                "str": (lambda s: s.strip('"')),
            },
        )
        # Preserve case
        parser.optionxform = str
        parser.read(path)

        image = parser.getstr(UNNAMED_SECTION, "image", fallback=None)
        if image:
            self.image = image

        net = parser.getstr(UNNAMED_SECTION, "net", fallback=None)
        if net:
            self.net = net

        self.mount_rw.extend(Config._load_paths(parser, "mount rw"))
        self.mount_ro.extend(Config._load_paths(parser, "mount ro"))


    @staticmethod
    def _load_paths(parser: ConfigParser, section: str) -> Iterable[Path]:
        if section not in parser:
            return

        for item in parser.items(section):
            yield Config._expand_path(item[0])

    @staticmethod
    def _expand_path(path: str) -> Path:
        fmt = Formatter()
        return Path(fmt.vformat(path, [], os.environ))

    def hash(self) -> str:
        d = hashlib.sha1()

        d.update("wd".encode())
        d.update(str(self.wd).encode())
        d.update("net".encode())
        d.update(self.net.encode())
        d.update("image".encode())
        d.update(self.image.encode())

        # Field labels are added into the mix to e.g. distinguish between:
        #
        #     mount_rw = ["/etc"], mount_ro = []
        #
        # and:
        #
        #     mount_rw = [], mount_ro = ["/etc"]
        #
        d.update("mount_rw".encode())
        for x in self.mount_rw:
            d.update(str(x).encode())

        d.update("mount_ro".encode())
        for x in self.mount_ro:
            d.update(str(x).encode())

        return d.hexdigest()


def git_is_inside_work_tree() -> bool:
    cmd = ["git", "rev-parse", "--is-inside-work-tree"]
    ret = subprocess.run(cmd, stdout=DEVNULL, stderr=DEVNULL)
    return ret.returncode == 0


def git_common_dir() -> Path:
    cmd = ["git", "rev-parse", "--git-common-dir"]
    out = subprocess.check_output(cmd)
    return PosixPath(out.decode().strip())


def get_volumes(cfg: Config) -> List[str]:
    mount_rw = [
        Path.cwd(),
    ]

    # Let's keep this somewhat minimal, and leave some unusual paths to be
    # configured manually
    mount_ro = [
        Path.home() / ".bash_profile",
        Path.home() / ".bashrc",
        Path.home() / ".config/fish",
        Path.home() / ".config/nvim",
        Path.home() / ".gitconfig",
        Path.home() / ".vimrc",
        Path.home() / ".zshrc",
    ]

    if git_is_inside_work_tree():
        # Resolve git common dir for the cases when repo is checked out in a
        # separate worktree
        d = git_common_dir().absolute()
        # .git dir is mounted as rw so that it would be possible to create
        # commits, checkout other branches and such
        mount_rw.append(d)
        # but more "dangerous" things like git hooks or git config are not
        # writable inside of the container
        mount_ro.append(d / "config")
        mount_ro.append(d / "hooks")

    volumes = [
        "--volume", f"{os.path.abspath(__file__)}:/usr/bin/larcik:ro",
    ]

    for path in mount_rw + cfg.mount_rw:
        if path.exists():
            volumes.extend(["--volume", f"{path}:{path}"])

    for path in mount_ro + cfg.mount_ro:
        if path.exists():
            volumes.extend(["--volume", f"{path}:{path}:ro"])

    return volumes


def podman_create(name: str, cfg: Config) -> None:
    network_opts = []
    if cfg.net == "none":
        network_opts = ["--network", "none"]

    cmd = [
        "podman",
        *PODMAN_GLOBAL_ARGS,
        "create",
        "--cgroupns", "host",
        "--hostname", "larcik",
        "--label", "com.dseight.larcik=true",
        "--label", f"com.dseight.larcik.wd={cfg.wd}",
        "--annotation", f"com.dseight.larcik.network={cfg.net}",
        "--annotation", f"com.dseight.larcik.cfghash={cfg.hash()}",
        "--name", name,
        "--no-hosts",
        *network_opts,
        "--security-opt", "label=disable",
        "--userns", "keep-id",
        "--passwd-entry", f"$USERNAME:*:$UID:$GID:$NAME:{Path.home()}:/bin/sh",
        "--mount", f"type=tmpfs,tmpfs-size=1024M,destination={Path.home()}",
        *get_volumes(cfg),
        "--workdir", cfg.wd,
        cfg.image,
        "larcik",
        "init-container",
    ]

    subprocess.check_call(cmd, stdout=DEVNULL)


def podman_start(name: str) -> None:
    cmd = [
        "podman",
        *PODMAN_GLOBAL_ARGS,
        "--hooks-dir", HOOKS_DIR,
        "start",
        name,
    ]
    subprocess.check_call(cmd, stdout=DEVNULL)


def podman_stop(name: str) -> None:
    cmd = [
        "podman",
        *PODMAN_GLOBAL_ARGS,
        "stop",
        name,
    ]
    subprocess.check_call(cmd, stdout=DEVNULL)


def podman_rm(name: str) -> None:
    cmd = [
        "podman",
        *PODMAN_GLOBAL_ARGS,
        "rm",
        name,
    ]
    subprocess.check_call(cmd, stdout=DEVNULL)


def podman_ps() -> List[str]:
    cmd = [
        "podman", "ps", "--all",
        "--filter", "label=com.dseight.larcik=true",
        "--format", "{{ .Names }}",
    ]
    return subprocess.check_output(cmd).decode().splitlines()


def podman_container_exists(name: str) -> bool:
    cmd = ["podman", "container", "exists", name]
    ret = subprocess.run(cmd, stdout=DEVNULL, stderr=DEVNULL)
    return ret.returncode == 0


def podman_check_file_exists(name: str, path: str) -> bool:
    cmd = [
        "podman",
        *PODMAN_GLOBAL_ARGS,
        "cp",
        f"{name}:{path}",
        "-",
    ]
    try:
        subprocess.check_call(cmd, stdout=DEVNULL, stderr=DEVNULL)
        return True
    except:
        return False


def get_larcik_workdir(name: str) -> Path:
    out = subprocess.check_output([
        "podman", "inspect",
        "--type", "container",
        "--format", '{{ index .Config.Labels "com.dseight.larcik.wd" }}',
        name,
    ])
    return PurePosixPath(out.decode().strip())


def get_larcik_cfghash(name: str) -> str:
    out = subprocess.check_output([
        "podman", "inspect",
        "--type", "container",
        "--format", '{{ index .Config.Annotations "com.dseight.larcik.cfghash" }}',
        name,
    ])
    return out.decode().strip()


def update_hooks() -> None:
    HOOKS_DIR.mkdir(parents=True, exist_ok=True)

    hook = {
        "version": "1.0.0",
        "hook": {
            "path": os.path.abspath(__file__),
            "args": ["larcik", "run-hooks"],
        },
        "when": {
            "annotations": {
                "com.dseight.larcik.network": ".*"
            }
        },
        "stages": ["prestart"]
    }

    hooks_file = HOOKS_DIR / "10-larcik.json"
    hooks_file.write_text(json.dumps(hook, indent=4) + "\n")


def _ensure_container_exists(name: str) -> None:
    if name not in podman_ps():
        sys.exit(
            f"No container with name {name} available, "
            "or available container is not a created by larcik"
        )


def _ensure_config_match(name: str, cfg: Config) -> None:
    # For example, if container was created with --net all, but then user
    # requests --net none in the same place, print a BIG RED ERROR that a new
    # container with a new name must be created instead. Otherwise one might
    # think that network is blocked, while it is not.

    if get_larcik_cfghash(name) == cfg.hash():
        return

    sys.exit(
        f"Container with name '{name}' is already created with different "
        "configuration.  Close it, and re-run the above command, "
        "or explicitly provide a new name."
    )


def get_default_name() -> str:
    # Try to use default name first
    name = f"larcik-{Path.cwd().name}"

    if not podman_container_exists(name):
        return name

    # If the default name is used together with another workdir (maybe user has
    # a dir named "project" in two places?), ask to provide explicit name.
    if get_larcik_workdir(name) != Path.cwd():
        sys.exit(
            f"The default name ('{name}') is already used together with another "
            "workdir (see `larcik list`). Use another name by providing it "
            f"explicitly, e.g. '{name}-2'."
        )

    return name


def parse_net_arg(arg: str) -> str:
    if arg in ("none", "local", "web", "all"):
        return arg

    if not arg.startswith("ip:"):
        print(f"Error: unknown value for --net option ('{arg}')")
        print("Falling back to 'none' for network access.")
        return "none"

    ips = arg[3:]

    for ip in ips.split(","):
        try:
            ipaddress.IPv4Address(ip)
        except ipaddress.AddressValueError as e:
            print(f"Error: --net {arg} option has invalid value. {e}")
            print("Falling back to 'none' for network access.")
            return "none"

    return ips


def _has_options_set(args: argparse.Namespace) -> bool:
    sub = getattr(args, "_subparser", None)
    if not sub:
        return False

    return any(
        getattr(args, action.dest) != sub.get_default(action.dest)
        for action in sub._actions
        if action.option_strings and action.dest != "help"
    )


def _cmd_open(args: argparse.Namespace):
    name = args.name if args.name else get_default_name()

    may_create = True
    may_exec = True

    if args.exec_only:
        may_create = False
    if args.create_only:
        may_exec = False

    cfg = Config.load()
    if args.net:
        cfg.net = parse_net_arg(args.net)
    if args.mount_rw:
        cfg.mount_rw.extend(args.mount_rw)
    if args.mount_ro:
        cfg.mount_ro.extend(args.mount_ro)

    if may_create and name not in podman_ps():
        podman_create(name, cfg)

    update_hooks()
    # XXX: run only if stopped?
    podman_start(name)

    if not may_exec:
        return

    _ensure_container_exists(name)

    # If user has provided some options, then check if requested configuration
    # matches what is already running. This will scream though when options are
    # the same, but config file was changed.
    if _has_options_set(args):
        _ensure_config_match(name, cfg)

    # Check if user's shell exists in the container. If not, gracefully
    # fallback to /bin/bash, and then to /bin/sh
    shells = [os.environ["SHELL"], "/bin/bash", "/bin/sh"]

    for sh in shells:
        if podman_check_file_exists(name, sh):
            os.execl("/usr/bin/podman", "podman", "exec", "-it", name, sh, "-l")

    sys.exit(f"No shell found in the container. Tried: {', '.join(shells)}")


def _cmd_close(args: argparse.Namespace):
    name = args.name if args.name else get_default_name()

    _ensure_container_exists(name)

    podman_stop(name)
    podman_rm(name)


def _cmd_list(args: argparse.Namespace):
    containers = podman_ps()

    if not containers:
        return

    # TODO: maybe colorize this a little bit?
    cmd = [
        "podman", "container", "inspect",
        "--format", '{{ .Name }} at ' +
        '{{ index .Config.Labels "com.dseight.larcik.wd" }} ' +
        'with net access to {{ index .Config.Annotations "com.dseight.larcik.network" }}',
        *containers
    ]

    subprocess.call(cmd)


def _cmd_run_hooks(args: argparse.Namespace):
    config = json.load(sys.stdin)
    pid = config["pid"]
    net = config["annotations"]["com.dseight.larcik.network"]

    # XXX: it is hard to debug hooks when they fail

    if net in ("all", "none"):
        return

    if net == "web":
        nft_conf = b"""
table inet filter {
    chain output {
        type filter hook output priority filter; policy accept;
        ip daddr 192.168.0.0/16 drop
    }
}
"""
    elif net == "local":
        nft_conf = b"""
table inet filter {
    chain output {
        type filter hook output priority filter; policy drop;
        ip daddr 192.168.0.0/16 accept
    }
}
"""
    else:
        nft_conf_tmp = """
table inet filter {
    chain output {
        type filter hook output priority filter; policy drop;
        ip daddr { IPS } accept
    }
}
"""
        nft_conf = nft_conf_tmp.replace("IPS", net).encode("utf-8")

    cmd = ["nsenter", "-t", str(pid), "-n", "nft", "-f", "/dev/stdin"]
    subprocess.run(cmd, input=nft_conf)


def _cmd_init_container(args: argparse.Namespace):
    # TODO: check that we run inside of a container first

    def handle_sigterm(signum, frame):
        sys.exit(0)

    signal.signal(signal.SIGTERM, handle_sigterm)
    signal.pause()
    sys.exit(0)


def main():
    parser = argparse.ArgumentParser()

    subparsers = parser.add_subparsers(dest="subcommand", title="subcommands")

    cmd_open = subparsers.add_parser("open", help="easy to open!")
    cmd_open.add_argument("name", nargs="?", help="Name of the container")
    group = cmd_open.add_mutually_exclusive_group()
    group.add_argument("-c", "--create-only", action="store_true",
                       help="Only create container, but don't exec it")
    group.add_argument("-e", "--exec-only", action="store_true",
                       help="Exec container, but don't try to create one if not exist")
    cmd_open.add_argument(
        "-n",
        "--net",
        help="allow access to network ('none', 'local', 'web', 'all' or 'ip:<comma-separated list of ipv4 addresses>'), default 'none'"
    )
    cmd_open.add_argument(
        "-r",
        "--mount-rw",
        nargs="+",
        metavar="PATH",
        type=Path,
        help="Mount extra path(s) as R/W"
    )
    cmd_open.add_argument(
        "-w",
        "--mount-ro",
        nargs="+",
        metavar="PATH",
        type=Path,
        help="Mount extra path(s) as R/O"
    )
    cmd_open.set_defaults(func=_cmd_open, _subparser=cmd_open)

    cmd_close = subparsers.add_parser("close", help="... and close")
    cmd_close.add_argument("name", nargs="?", help="Name of the container")
    cmd_close.set_defaults(func=_cmd_close)

    cmd_list = subparsers.add_parser("list", help="let's see what you have there")
    cmd_list.set_defaults(func=_cmd_list)

    # TODO: find a way to hide run-hooks and init-container from -h/--help
    cmd_run_hooks = subparsers.add_parser("run-hooks")
    cmd_run_hooks.set_defaults(func=_cmd_run_hooks)

    cmd_init_container = subparsers.add_parser("init-container")
    cmd_init_container.set_defaults(func=_cmd_init_container)

    args = parser.parse_args()

    if not args.subcommand:
        parser.error("subcommand required!")

    args.func(args)

    # TODO:
    # - warn if submodules are not absorbed? (that would mean that hooks still
    #   can be installed on submodules)


if __name__ == "__main__":
    main()
